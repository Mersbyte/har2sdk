    "Price": "amount, currency",
    "CartItem": "id, productId, name, quantity, unitPrice",
    "UpdateCartItemBody": "quantity",
    "Loyalty": "tier, points",
    "Me": "id, email, name, locale, loyalty, createdAt",
    "CreateNewsletterBody": "email, consent",
    "Newsletter": "subscribed",
    "Total": "= Price",
    "Order": "id, status, createdAt, total, itemCount",
    "ListOrdersResponse": "items, page, total",
    "ShippingAddress": "name, line1, city, postalCode, country",
    "Line": "productId, quantity, unitPrice",
    "Tracking": "carrier, code, url",
    "GetOrderResponse": "id, status, createdAt, total, itemCount, shippingAddress, lines, tracking",
    "Refund": "amount, currency, eta",
    "CancelOrderResponse": "id, status, refund",
    "Discount": "percent, endsAt",
    "Product": "id, sku, name, category, price, inStock, rating, tags, updatedAt, discount?",
